# Private Keys - NEVER USE REAL KEYS IN EXAMPLE FILES
# Use environment variables or secure key management in production
PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE
DEPLOYER_PRIVATE_KEY=YOUR_DEPLOYER_PRIVATE_KEY_HERE

# RPC URLs
