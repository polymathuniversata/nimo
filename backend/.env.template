# Nimo Backend - Environment Variables Template

# ===========================================
# CRITICAL SECURITY SETTINGS
# ===========================================
# These must be changed in production with strong, randomly generated values

# Flask Secret Key (REQUIRED - Generate a secure 32+ character key)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="CHANGE_THIS_IN_PRODUCTION_WITH_A_STRONG_RANDOM_KEY"

# JWT Secret Key (REQUIRED - Generate a secure 32+ character key)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="CHANGE_THIS_IN_PRODUCTION_WITH_A_STRONG_RANDOM_KEY"

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================

# Flask Environment
FLASK_ENV=production
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Server Configuration
SERVER_NAME=
PREFERRED_URL_SCHEME=https
SSL_REDIRECT=true

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# PostgreSQL Database URL (Production)
DATABASE_URL=postgresql://nimo_user:CHANGE_THIS_PASSWORD@localhost:5432/nimo_db

# Database Connection Pool
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600

# ===========================================
# REDIS CONFIGURATION
# ===========================================

# Redis URL for caching and sessions
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_CONNECT_TIMEOUT=5

# ===========================================
# BLOCKCHAIN CONFIGURATION
# ===========================================

# Cardano Network Configuration
CARDANO_NETWORK=preview
BLOCKFROST_PROJECT_ID_PREVIEW=your_blockfrost_preview_api_key_here
BLOCKFROST_PROJECT_ID_PREPROD=your_blockfrost_preprod_api_key_here
BLOCKFROST_PROJECT_ID_MAINNET=your_blockfrost_mainnet_api_key_here

# Cardano Service Keys (Generate new keys for production)
CARDANO_SERVICE_PRIVATE_KEY=your_cardano_service_private_key_here
CARDANO_SERVICE_KEY_FILE=service_key.skey

# Ethereum/Base Network Configuration
WEB3_PROVIDER_URL=https://sepolia.base.org
BLOCKCHAIN_SERVICE_PRIVATE_KEY=your_ethereum_service_private_key_here

# ===========================================
# EMAIL CONFIGURATION
# ===========================================

# SMTP Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# ===========================================
# EXTERNAL SERVICES
# ===========================================

# IPFS Configuration
IPFS_URL=http://localhost:5001
IPFS_TIMEOUT=30

# MeTTa Configuration
METTA_DATABASE_PATH=backend/metta_state/metta_database.json
METTA_CORE_RULES_PATH=backend/rules/core_rules.metta
USE_METTA_REASONING=true
METTA_MODE=enhanced
METTA_CONFIDENCE_THRESHOLD=0.7
METTA_FRAUD_DETECTION_THRESHOLD=0.8
METTA_BATCH_SIZE=100
METTA_CACHE_TTL=3600
METTA_QUERY_TIMEOUT=30
METTA_ENABLE_CACHE=true

# ===========================================
# MONITORING AND LOGGING
# ===========================================

# Sentry Error Tracking
SENTRY_DSN=https://your_sentry_dsn_here

# Logging Configuration
LOG_LEVEL=INFO
LOG_DIR=logs
ENABLE_FILE_LOGGING=true
ENABLE_JSON_LOGGING=true
MAX_LOG_SIZE=10485760
LOG_BACKUP_COUNT=5

# Prometheus Metrics
PROMETHEUS_METRICS_ENABLED=true

# ===========================================
# SECURITY SETTINGS
# ===========================================

# Rate Limiting
DEFAULT_RATE_LIMIT=100
AUTH_RATE_LIMIT=10
RATE_LIMIT_WINDOW=300

# Security Headers
SECURITY_HEADERS_ENABLED=true
CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';"

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Session Security
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict

# ===========================================
# FEATURE FLAGS
# ===========================================

# Core Features
FEATURE_WALLET_AUTH=true
FEATURE_METTA_INTEGRATION=true
FEATURE_AUTO_REWARDS=true
FEATURE_ADA_REWARDS=true
FEATURE_NIMO_REWARDS=true
FEATURE_IDENTITY_VERIFICATION=true
FEATURE_AUTONOMOUS_SYSTEM=true
FEATURE_FRAUD_DETECTION=true
FEATURE_BATCH_PROCESSING=true
FEATURE_PERFORMANCE_MONITORING=true
FEATURE_CACHE_OPTIMIZATION=true

# ===========================================
# AUTONOMOUS SYSTEM CONFIGURATION
# ===========================================

# Autonomous System Settings
AUTONOMOUS_SYSTEM_ENABLED=true
AUTONOMOUS_CYCLE_INTERVAL=300
AUTONOMOUS_BATCH_SIZE=50
AUTONOMOUS_MAX_CONCURRENT=10
AUTONOMOUS_RETRY_ATTEMPTS=3
AUTONOMOUS_RETRY_DELAY=5

# ===========================================
# TOKEN CONFIGURATION
# ===========================================

# NIMO Token Settings
NIMO_TOKEN_POLICY_ID_PREVIEW=
NIMO_TOKEN_POLICY_ID_PREPROD=
NIMO_TOKEN_POLICY_ID_MAINNET=
NIMO_TOKEN_ASSET_NAME=NIMO
ADA_TO_NIMO_RATE=100
NIMO_DECIMAL_PLACES=6
NIMO_MIN_MINT_AMOUNT=1
NIMO_MAX_MINT_AMOUNT=1000000

# Reward Configuration
MIN_ADA_REWARD=1000000
MAX_ADA_REWARD=10000000
MIN_NIMO_REWARD=10
MAX_NIMO_REWARD=1000
CONFIDENCE_REWARD_MULTIPLIER=1.5

# ===========================================
# DEVELOPMENT SETTINGS (DISABLE IN PRODUCTION)
# ===========================================

# Development Features (Set to false in production)
MOCK_EXTERNAL_SERVICES=false
SKIP_AUTH_FOR_TESTING=false
DEBUG_SQL_QUERIES=false

# ===========================================
# PRODUCTION SECURITY CHECKLIST
# ===========================================
# BEFORE DEPLOYING TO PRODUCTION, ENSURE:
#
# 1. SECRET KEYS CHANGED:
#    - SECRET_KEY: Generate with `python -c "import secrets; print(secrets.token_hex(32))"`
#    - JWT_SECRET_KEY: Generate with `python -c "import secrets; print(secrets.token_hex(32))"`
#
# 2. DATABASE CONFIGURED:
#    - DATABASE_URL: Set to production PostgreSQL instance
#    - Database credentials are strong and unique
#
# 3. BLOCKCHAIN KEYS SECURE:
#    - CARDANO_SERVICE_PRIVATE_KEY: Generate new keypair for production
#    - BLOCKCHAIN_SERVICE_PRIVATE_KEY: Generate new keypair for production
#    - BLOCKFROST_PROJECT_ID_*: Get from Blockfrost dashboard
#
# 4. NETWORK SECURITY:
#    - FLASK_HOST: Keep as 127.0.0.1 (use reverse proxy for external access)
#    - SSL_REDIRECT: Set to true
#    - SESSION_COOKIE_SECURE: Set to true
#
# 5. MONITORING ENABLED:
#    - SENTRY_DSN: Configure error tracking
#    - PROMETHEUS_METRICS_ENABLED: Set to true
#    - LOG_LEVEL: Set to WARNING or ERROR in production
#
# 6. RATE LIMITING CONFIGURED:
#    - Adjust rate limits based on expected traffic
#    - AUTH_RATE_LIMIT: Keep low for security
#
# 7. BACKUP AND RECOVERY:
#    - Database backup strategy in place
#    - Redis persistence configured
#    - Log retention policy defined
#
# SECURITY NOTES:
# - Never commit this file with real secrets to version control
# - Use environment-specific .env files
# - Rotate secrets regularly
# - Monitor for suspicious activity
# - Keep dependencies updated
