# Flask Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# =================================================================
# SECURITY CONFIGURATION - CRITICAL
# =================================================================
# SECURITY AUDIT: Hardcoded secrets removed from codebase
# All secrets now use environment variables

# Flask Application Secrets
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_ENVIRONMENT
JWT_SECRET_KEY=CHANGE_JWT_SECRET_IN_PRODUCTION

# =================================================================
# LOGGING CONFIGURATION
# =================================================================
LOG_LEVEL=INFO
LOG_DIR=logs
ENABLE_FILE_LOGGING=true
ENABLE_JSON_LOGGING=false
MAX_LOG_SIZE=10485760
LOG_BACKUP_COUNT=5

# =================================================================
# ERROR TRACKING
# =================================================================
SENTRY_DSN=your_sentry_dsn_here

# =================================================================
# MeTTa Configuration
# =================================================================
USE_METTA_REASONING=True
METTA_DB_PATH=backend/temp/metta_store.json
METTA_RULES_PATH=backend/rules/core_rules.metta
METTA_CONFIDENCE_THRESHOLD=0.7

# =================================================================
# Database Configuration
# =================================================================
DATABASE_URL=sqlite:///dev.db

# =================================================================
# BLOCKCHAIN CONFIGURATION - POLYGON MUMBAI TESTNET
# =================================================================
BLOCKCHAIN_NETWORK=polygon-mumbai
WEB3_PROVIDER_URL=https://polygon-mumbai.g.alchemy.com/v2/demo
NIMO_IDENTITY_CONTRACT_POLYGON_MUMBAI=
NIMO_TOKEN_CONTRACT_POLYGON_MUMBAI=
USDC_CONTRACT_POLYGON_MUMBAI=0x4CE536b148BF86Ce30E2A28E610e3B2df973d9Af

# =================================================================
# SERVICE ACCOUNT CONFIGURATION
# =================================================================
# SECURITY AUDIT: Private keys must NEVER be hardcoded
# Use secure key management systems in production
#
# Options for secure key management:
# 1. AWS KMS, Azure Key Vault, GCP Secret Manager
# 2. HashiCorp Vault
# 3. Environment variables (development only)
# 4. Hardware Security Modules (HSM)
#
# NEVER store private keys in this file or version control
BLOCKCHAIN_SERVICE_PRIVATE_KEY=YOUR_SECURE_PRIVATE_KEY_HERE

